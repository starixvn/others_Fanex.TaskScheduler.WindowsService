<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
    <section name="TaskScheduler" type="Fanex.TaskScheduler.WindowsService.Configuration.TaskSchedulerSettings, Fanex.TaskScheduler.WindowsService" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.40.40.127/msmq/Private$/entlib" defaultCategory="NAP-Report-Service"/>
  <Fanex.MailDelivery.Client environment="Live" applicationSendMailId="1" siteId="10" rabbitMQConnectionString="host=10.40.40.127;virtualHost=/MailStationHost;username=rabbitclient;timeout=3600" messageBrokerLogCategory="MailCentralized">
    <Schedules>
      <Schedule id="103" name="House Month-to-Date Net Income Report" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="112" name="FIN Management Monthly Report" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="124" name="Other Sports Bet Monitoring" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="126" name="SMA Monthly Automail Report - UAT" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="127" name="SMA Monthly Automail Report" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="130" name="Active Member Per Platform" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="133" name="Smart Punter Monitoring Action" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="137" name="Daily Casino WinLoss - DCWL - Letstalk Service" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
    </Schedules>
  </Fanex.MailDelivery.Client>

  <ONEbook.UM ServiceUris="http://10.40.40.22:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000000" UMPageUrl="~/UserLogin/Common/Offline">
    <!--<AllowedIPs AllowAll="true">
      <add Value="10.19.10.54" />
      -->
    <!--Exact IP-->
    <!--
      <add From="10.19.10.100" To="10.19.10.200" />
      -->
    <!--IP Range-->
    <!--
    </AllowedIPs>-->
  </ONEbook.UM>
  <TaskScheduler>
    <Tasks>
      <add Id="103" Executable="\\10.40.40.127\e$\1.Services\1.NAP-Report\Fanex.DW.HouseIncome.Service\Fanex.DW.HouseIncome.Executing.exe" />
      <add Id="112" Executable="\\10.40.40.127\e$\1.Services\1.NAP-Report\Fanex.DW.FIN.Service\Fanex.DW.FIN.Executing.exe" />
      <add Id="124" Executable="\\10.40.40.127\e$\1.Services\1.NAP-Report\Fanex.DW.BettingMonitoring.Executing\Fanex.DW.BettingMonitoring.Executing.exe" />
      <add Id="126" Executable="\\10.40.40.127\e$\1.Services\1.NAP-Report\_Fanex.AutoMail.SMAMonthlyReport.Service-UAT\Fanex.SMAMonthlyReport.Executing.exe" />
      <add Id="127" Executable="\\10.40.40.127\e$\1.Services\1.NAP-Report\Fanex.AutoMail.SMAMonthlyReport.Service\Fanex.SMAMonthlyReport.Executing.exe" />
      <add Id="130" Executable="\\10.40.40.127\e$\1.Services\1.NAP-Report\Fanex.ActiveMember.Executing\Fanex.DW.ActiveMembers.Executing.exe" />
      <add Id="133" Executable="\\10.40.40.127\e$\1.Services\1.NAP-Report\Fanex.SmartPunterMonitoringAction.Executing\Fanex.SmartPunterMonitoringAction.Executing.exe" />
      <add Id="137" Executable="E:\1.Services\1.NAP-Report\Fanex.DCWL.Executing\Fanex.DCWL.Executing.exe" />
    </Tasks>
  </TaskScheduler>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="RabbitMQ.Client" publicKeyToken="89e7d7c5feba84ce" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.4.0" newVersion="3.5.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>