<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
    <section name="TaskScheduler" type="Fanex.TaskScheduler.WindowsService.Configuration.TaskSchedulerSettings, Fanex.TaskScheduler.WindowsService" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:172.16.4.106\private$\entlib" defaultCategory="NAP-Report-SIT"/>  
    
  <Fanex.MailDelivery.Client
    environment="Live"
    applicationSendMailId="48"
    siteId="10"
    rabbitMQConnectionString="host=172.16.4.106,172.16.4.107;virtualHost=/MailStationHost;username=rabbitclient;timeout=3600"
    messageBrokerLogCategory="MailCentralized">
    <Schedules>
      <Schedule id="96" name="Other Sports Bet Monitoring" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="112" name="TOControl - Customer Movement" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="117" name="Loss Monitoring - Customer Movement" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="121" name="House Net Income Daily Report" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
    </Schedules>
  </Fanex.MailDelivery.Client>

  <ONEbook.UM ServiceUris="http://172.16.4.106:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000000" UMPageUrl="~/UserLogin/Common/Offline">
  </ONEbook.UM>
  <TaskScheduler>
    <Tasks>
      <add Id="96" Executable="\\172.16.4.106\d$\Web\10.Nap-AutoMail\3.Fanex.DW.BettingMonitoring.Executing\Fanex.DW.BettingMonitoring.Executing.exe" />
      <add Id="112" Executable="\\172.16.4.106\d$\Web\10.Nap-AutoMail\7.TOControl.CustomerMovement.Service\TOControl.CustomerMovement.Executing.exe" />
      <add Id="117" Executable="\\172.16.4.106\d$\Web\10.Nap-AutoMail\8.LossMonitoring.CustomerMovement.Service\LossMonitoring.CustomerMovement.Executing.exe" />
      <add Id="121" Executable="\\172.16.4.106\d$\Web\10.Nap-AutoMail\9.HouseIncome.Daily.Service\HouseIncome.Daily.Executing.exe" />
    </Tasks>
  </TaskScheduler>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="RabbitMQ.Client" publicKeyToken="89e7d7c5feba84ce" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.4.0" newVersion="3.5.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>