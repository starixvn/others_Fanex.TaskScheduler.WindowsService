    </Schedules>
  </Fanex.MailDelivery.Client>

  <ONEbook.UM ServiceUris="http://172.16.4.106:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000000" UMPageUrl="~/UserLogin/Common/Offline">
