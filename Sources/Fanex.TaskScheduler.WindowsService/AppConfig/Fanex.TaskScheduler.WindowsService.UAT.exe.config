<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
    <section name="TaskScheduler" type="Fanex.TaskScheduler.WindowsService.Configuration.TaskSchedulerSettings, Fanex.TaskScheduler.WindowsService" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.40.40.73\private$\entlib" defaultCategory="NAP-Report-Service-UAT" />
  <Fanex.MailDelivery.Client environment="Live" applicationSendMailId="1" siteId="10" rabbitMQConnectionString="host=10.40.40.127;virtualHost=/MailStationHost;username=rabbitclient;timeout=3600" messageBrokerLogCategory="MailCentralized">
    <Schedules>
      <Schedule id="125" name="House Month-to-Date Net Income Report - UAT" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="129" name="FIN Management Monthly Report - UAT" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="131" name="Save Bets - UAT" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="134" name="Daily Casino WinLoss - DCWL - Letstalk Service - UAT" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
    </Schedules>
  </Fanex.MailDelivery.Client>

  <ONEbook.UM ServiceUris="http://10.40.40.22:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000000" UMPageUrl="~/UserLogin/Common/Offline">
    <!--<AllowedIPs AllowAll="true">
      <add Value="10.19.10.54" />
      --><!--Exact IP--><!--
      <add From="10.19.10.100" To="10.19.10.200" />  
      --><!--IP Range--><!--
    </AllowedIPs>-->
  </ONEbook.UM>
  <TaskScheduler>
    <Tasks>
      <add Id="125" Executable="\\10.40.40.73\e$\2.NAP\14.NapReport\_Fanex.DW.HouseIncome.Service\Fanex.DW.HouseIncome.Executing.exe" />
      <add Id="129" Executable="\\10.40.40.73\e$\2.NAP\14.NapReport\_Fanex.DW.FIN.Service\Fanex.DW.FIN.Executing.exe" />
      <add Id="131" Executable="\\10.40.40.73\e$\2.NAP\14.NapReport\Fanex.SaveBets.Console.Testing\Fanex.SaveBets.Testing.exe" />
      <add Id="134" Executable="E:\2.NAP\14.NapReport\Fanex.DCWL.Executing\Fanex.DCWL.Executing.exe" />
    </Tasks>
  </TaskScheduler>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="RabbitMQ.Client" publicKeyToken="89e7d7c5feba84ce" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.4.0" newVersion="3.5.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <appSettings>
    <add key="UMServiceURL" value="http://172.16.4.32:8000/api/UM/|http://172.16.4.32:9000/api/UM/" />
  </appSettings>
</configuration>