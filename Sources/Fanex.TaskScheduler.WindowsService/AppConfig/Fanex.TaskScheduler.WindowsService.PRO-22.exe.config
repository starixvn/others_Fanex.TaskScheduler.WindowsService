<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="TaskScheduler" type="Fanex.TaskScheduler.WindowsService.Configuration.TaskSchedulerSettings, Fanex.TaskScheduler.WindowsService" />
		<section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
		<sectionGroup name="common">
			<section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging" />
		</sectionGroup>
		<section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
	</configSections>
	<appSettings>
		<add key="ServiceName" value="Fanex.TaskScheduler.WindowsService" />
		<add key="ONEbook.UM:ServiceUri" value="http://10.2.27.8:7446/api" />
		<add key="ONEbook.UM:EnableCheckUM" value="true" />
		<add key="ONEbook.UM:SiteId" value="2000000" />
		<add key="ONEbook.UM:EnableUnscheduledUM" value="false" />
		<add key="ONEbook.UM:UMFrom" value="3:00" />
		<add key="ONEbook.UM:UMTo" value="4:00" />
		<add key="ONEbook.UM:UMPageUrl" value="/UserLogin/Common/Offline" />
		<add key="ONEbook.UM:ResultCacheDuration" value="60" />
		<add key="ONEbook.UM:UMLoggingCategory" value="ONEbook-UM" />
		<add key="ONEbook.UM:ErrorUMPageUrl" value="" />
	</appSettings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
	</startup>
	<Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.40.40.11\private$\entlib" defaultCategory="NAP-Report-Service" />
	<Fanex.MailDelivery.Client applicationSendMailId="1" siteId="10" rabbitMQConnectionString="host=10.99.99.51;virtualHost=/MailStationHost;username=rabbitclient;timeout=3600">
		<Schedules>
			<Schedule id="173" name="Balance Monthly Report - Credit Term" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
			<Schedule id="179" name="Balance Monthly Report - Super Balance" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
			<Schedule id="177" name="Balance Monthly Report - Direct Balance" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
			<!--<Schedule id="372" name="Letstalk - DHWL - Daily - PRE" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />-->
			<!--<Schedule id="373" name="Letstalk - DHWL - Monthly - PRE" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />-->
			<Schedule id="376" name="Letstalk - OneTime - 0500" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
			<!--<Schedule id="411" name="Letstalk - Daily Margin Chart - ID05" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />-->
			<Schedule id="412" name="Letstalk - OneTime - 0505" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
			<!--<Schedule id="549" name="Letstalk - DHWL - YTD" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />-->
			<Schedule id="249" name="Letstalk - Margin Variance - Daily" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
		</Schedules>
	</Fanex.MailDelivery.Client>

	<TaskScheduler>
		<Tasks>
			<add Id="173" Executable="\\10.40.40.11\e$\www\SERVICES\Olympus\Fanex.BalanceMonthlyReportCreditTerm.Service\Fanex.BalanceMonthlyReportCreditTerm.Executing.exe" />
			<add Id="179" Executable="\\10.40.40.11\e$\www\SERVICES\Olympus\Fanex.BalanceMonthlyReportSuperBalance.Service\Fanex.BalanceMonthlyReportSuperBalance.Executing.exe" />
			<add Id="177" Executable="\\10.40.40.11\e$\www\SERVICES\Olympus\Fanex.BalanceMonthlyReportDirectBalance.Service\Fanex.BalanceMonthlyReportDirectBalance.Executing.exe" />
			<!--<add Id="372" Executable="\\10.40.40.11\e$\WWW\SERVICES\Olympus\DHWL.Executing\Fanex.DailyDHWL.Executing.exe" />-->
			<!--<add Id="373" Executable="\\10.40.40.11\e$\WWW\SERVICES\Olympus\Monthly-DHWL.Executing\Fanex.MonthlyDHWL.Executing.exe" />-->
			<add Id="376" Executable="\\10.40.40.11\e$\WWW\SERVICES\Olympus\LetstalkOneTime-0500\Fanex.Letstalk.OneTime.Executing.exe" />
			<!--<add Id="411" Executable="\\10.40.40.11\e$\WWW\SERVICES\Olympus\MarginChart-Daily.Service-NEW\Fanex.MarginChart.Executing.exe" />-->
			<add Id="412" Executable="\\10.40.40.11\e$\WWW\SERVICES\Olympus\LetstalkOneTime-0505\Fanex.Letstalk.OneTime.Executing.exe" />
			<!--<add Id="549" Executable="\\10.40.40.11\e$\www\SERVICES\Olympus\Monthly-DHWL-YTD.Executing\Fanex.MonthlyChart.Executing.exe" />-->
			<add Id="249" Executable="\\10.40.40.11\e$\www\SERVICES\Olympus\MarginVariance-Daily.Service-Pro\Daily.MarginVariance.Executing.exe" />
		</Tasks>
	</TaskScheduler>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-1.2.15.0" newVersion="1.2.15.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Practices.EnterpriseLibrary.Common" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.0.505.0" newVersion="5.0.505.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Practices.EnterpriseLibrary.Logging" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.0.505.0" newVersion="5.0.505.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Practices.Unity.Interception" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-2.0.414.0" newVersion="2.0.414.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Practices.Unity" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-2.0.414.0" newVersion="2.0.414.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Net.Http" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.0.0" newVersion="4.0.0.0" />
