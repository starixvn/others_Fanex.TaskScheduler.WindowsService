<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="TaskScheduler" type="Fanex.TaskScheduler.WindowsService.Configuration.TaskSchedulerSettings, Fanex.TaskScheduler.WindowsService" />
		<section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
		<sectionGroup name="common">
			<section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging" />
		</sectionGroup>
		<section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
	</configSections>
	<appSettings>
		<add key="StoredProcedurePath" value="App_Data\Test" />
		<add key="ServiceName" value="Fanex.TaskScheduler.WindowsService" />
		<add key="ONEbook.UM:ServiceUri" value="http://ha.nexdev.net:8889/api" />
		<add key="ONEbook.UM:EnableCheckUM" value="true" />
		<add key="ONEbook.UM:SiteId" value="2000000" />
		<add key="ONEbook.UM:EnableUnscheduledUM" value="false" />
		<add key="ONEbook.UM:UMFrom" value="3:00" />
		<add key="ONEbook.UM:UMTo" value="4:00" />
		<add key="ONEbook.UM:UMPageUrl" value="/UserLogin/Common/Offline" />
		<add key="ONEbook.UM:ResultCacheDuration" value="60" />
		<add key="ONEbook.UM:UMLoggingCategory" value="ONEbook-UM" />
		<add key="ONEbook.UM:ErrorUMPageUrl" value="" />
	</appSettings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
	</startup>
	<Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.124\private$\entlib" defaultCategory="NAP-Report-Service-LOCAL" />
	<common>
		<logging>
			<factoryAdapter type="Common.Logging.Log4Net.Universal.Log4NetFactoryAdapter, Common.Logging.Log4Net.Universal" />
		</logging>
	</common>
	<Fanex.MailDelivery.Client environment="local" applicationSendMailId="1" siteId="3" rabbitMQConnectionString="host=10.18.200.131:5672;virtualHost=/MailStationHost;username=rabbitclient">
		<Schedules>
			<Schedule id="358" name="Letstalk - OneTime" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
			<Schedule id="369" name="Letstalk - DHWL - Daily" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
		</Schedules>
	</Fanex.MailDelivery.Client>

	<TaskScheduler>
		<Tasks>
			<add Id="358" Executable="\\10.18.200.120\Olympus\LetstalkOneTime\Fanex.Letstalk.OneTime.Executing.exe" />
			<add Id="369" Executable="\\10.18.200.120\www\Olympus\DHWL.Executing\Fanex.DailyDHWL.Executing.exe" />
		</Tasks>
	</TaskScheduler>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-1.2.15.0" newVersion="1.2.15.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Net.Http" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.0.0" newVersion="4.0.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>