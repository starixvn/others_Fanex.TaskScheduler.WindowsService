<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
    <section name="TaskScheduler" type="Fanex.TaskScheduler.WindowsService.Configuration.TaskSchedulerSettings, Fanex.TaskScheduler.WindowsService" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.18.200.124\private$\entlib" defaultCategory="NAP-Report-Service-LOCAL" />
  <Fanex.MailDelivery.Client environment="local" applicationSendMailId="1" siteId="3" rabbitMQConnectionString="host=10.18.200.124;virtualHost=/QCLocalTest;username=rabbitclient;timeout=3600" messageBrokerLogCategory="MailCentralized">
    <Schedules>
      <Schedule id="202" name="House Month-to-Date Net Income Report" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="204" name="FIN Management Monthly Report" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="222" name="Other Sports Bet Monitoring" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="93" name="SMA Monthly Automail Report" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
      <Schedule id="239" name="Daily Casino WinLoss - DCWL - Letstalk Service" job="Fanex.TaskScheduler.WindowsService.TaskRunner, Fanex.TaskScheduler.WindowsService" />
    </Schedules>
  </Fanex.MailDelivery.Client>

  <ONEbook.UM ServiceUris="http://10.18.200.124:8889/api" EnableCheckUM="false" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000000" UMPageUrl="~/">
    <AllowedIPs AllowAll="true">
      <add Value="10.19.10.54" />
      <!--Exact IP-->
      <add From="10.19.10.100" To="10.19.10.200" />
      <!--IP Range-->
    </AllowedIPs>
  </ONEbook.UM>
  <TaskScheduler>
    <Tasks>
      <add Id="202" Executable="D:\Web\1.Rome\2.Nap\3.WindowServices\13.Fanex.DW.HouseIncome.Executing\Fanex.DW.HouseIncome.Executing.exe" />
      <add Id="204" Executable="D:\Web\1.Rome\2.Nap\3.WindowServices\16.Fanex.DW.FIN.Executing\Fanex.DW.FIN.Executing.exe" />
      <add Id="222" Executable="\\10.18.200.202\Web\1.Rome\2.Nap\3.WindowServices\17.Fanex.BettingMonitoring.Executing\Fanex.DW.BettingMonitoring.Executing.exe" />
      <add Id="93" Executable="D:\Data\3.Working\fanex-automail-smareport\Fanex.SMAMonthlyReport.Executing\bin\Debug\Fanex.SMAMonthlyReport.Executing.exe" />
      <add Id="239" Executable="D:\Data\6.Testing\DCWL\Fanex.DCWL.Executing.exe" />
    </Tasks>
  </TaskScheduler>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="RabbitMQ.Client" publicKeyToken="89e7d7c5feba84ce" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.4.0" newVersion="3.5.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <appSettings>
    <add key="UMServiceURL" value="http://172.16.4.32:8000/api/UM/|http://172.16.4.32:9000/api/UM/" />
  </appSettings>
</configuration>