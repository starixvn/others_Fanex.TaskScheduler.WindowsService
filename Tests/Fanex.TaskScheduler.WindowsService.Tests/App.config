<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="TaskScheduler" type="Fanex.TaskScheduler.WindowsService.Configuration.TaskSchedulerSettings, Fanex.TaskScheduler.WindowsService" />
  <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" /><section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" /></configSections>
  <TaskScheduler>
    <Tasks>
      <add Id="1" Executable="D:\Test.exe" />
    </Tasks>
  </TaskScheduler>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="RabbitMQ.Client" publicKeyToken="89e7d7c5feba84ce" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.4.0" newVersion="3.5.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
<Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" /><Fanex.MailDelivery.Client environment="local" applicationSendMailId="1" siteId="1" rabbitMQConnectionString="host=10.18.200.209,10.18.200.202;virtualHost=/philliphost;username=rabbitclient" messageBrokerLogCategory="MailCentralized">
        <Functions>
          <!--<add id="1" name="YourFunction" />-->
        </Functions>
        <Schedules>
          <!--<Schedule id="2" name="YourSchedule" job="YourProject.Namespace.Job, YourProject">-->
        </Schedules>
    </Fanex.MailDelivery.Client></configuration>